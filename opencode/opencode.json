{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
   "skills": [
    "~/shared/opencode-skills",
  ],
  "instructions": [
    "~/shared/opencode-skills/dev-principles/SKILL.md",
    "~/.config/opencode/instructions/coding-guidelines.md",
    "~/.config/opencode/instructions/code-answers.md",
    "~/.config/opencode/instructions/readme-is-documentation.md",
    "~/.config/opencode/instructions/review-before-finishing.md",
    "~/.config/opencode/instructions/lint-auto-fix.md",
    "~/.config/opencode/instructions/prefer-tools-over-shell.md"
  ],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.key",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "id_rsa*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "id_ed25519",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".aws/credentials",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".gcloud/**",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git status",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status --short",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff --cached",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ast-grep*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "head *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sort *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "uniq *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rg *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "fd *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm -rf*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -f*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -r*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "chmod*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npm*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "npx*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "printenv*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "docker*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sort *-o*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rg *--pre*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "fd *-x*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "fd *--exec*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "fd *-X*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git log *--output*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/shared/opencode-skills/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/instructions/*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp",
        "disabled": false,
        "oauth": {}
      }
    }
  },
  "plugins": [
    "-opencode.provider.vllm"
  ],
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "vllm",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "local",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "ollama",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "lmstudio",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "llamacpp",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "opencode-local",
        "effect": "deny"
      }
    ]
  }
}
