{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "default"
  },
  "keybinds": {
    "session.interrupt": "ctrl+q",
    "input.submit": "ctrl+return,alt+return",
    "input.newline": "return,ctrl+j,shift+return"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show"
  },
  "animations": true,
  "tabs": {
    "enabled": false,
    "layout": "horizontal"
  }
}
