{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "blue",
      "purple",
      "green",
      "orange",
      "red"
    ],
    "text": {
      "base": "#cad3f5",
      "muted": "#b8c0e0",
      "faint": "#8087a2",
      "action": {
        "primary": {
          "base": "#b8c0e0",
          "$hovered": "#181926",
          "$focused": "#181926",
          "$pressed": "#181926",
          "$selected": "#181926",
          "$disabled": "#6e738d"
        },
        "secondary": {
          "base": "#b8c0e0",
          "$hovered": "#cad3f5",
          "$focused": "#cad3f5",
          "$pressed": "#cad3f5",
          "$disabled": "#6e738d"
        },
        "destructive": {
          "base": "#24273a",
          "$hovered": "#181926",
          "$focused": "#181926",
          "$pressed": "#181926",
          "$disabled": "#6e738d"
        }
      },
      "formfield": {
        "base": "#b8c0e0",
        "$hovered": "#cad3f5",
        "$focused": "#cad3f5",
        "$pressed": "#cad3f5",
        "$selected": "#8aadf4",
        "$disabled": "#6e738d"
      },
      "feedback": {
        "error": {
          "base": "#ed8796"
        },
        "warning": {
          "base": "#eed49f"
        },
        "success": {
          "base": "#a6da95"
        },
        "info": {
          "base": "#8bd5ca"
        }
      }
    },
    "background": {
      "base": "transparent",
      "raised": {
        "base": "#1e2030",
        "high": "#363a4f",
        "max": "#494d64"
      },
      "action": {
        "primary": {
          "base": "#363a4f",
          "$hovered": "#8aadf4",
          "$focused": "#8aadf4",
          "$pressed": "#8aadf4",
          "$selected": "#8aadf4",
          "$disabled": "#363a4f"
        },
        "secondary": {
          "base": "transparent",
          "$hovered": "#363a4f"
        },
        "destructive": {
          "base": "#ed8796",
          "$hovered": "#ee99a0",
          "$focused": "#ed8796",
          "$pressed": "#ee99a0",
          "$selected": "#ee99a0",
          "$disabled": "#363a4f"
        }
      },
      "formfield": {
        "base": "transparent"
      },
      "feedback": {
        "error": {
          "base": "transparent"
        },
        "warning": {
          "base": "#eed49f1a"
        },
        "success": {
          "base": "transparent"
        },
        "info": {
          "base": "transparent"
        }
      }
    },
    "border": {
      "base": "#363a4f"
    },
    "scrollbar": {
      "base": "#494d64"
    },
    "diff": {
      "text": {
        "added": "#a6da95",
        "removed": "#ed8796",
        "context": "#939ab7",
        "hunkHeader": "#f5a97f"
      },
      "background": {
        "added": "#a6da9580",
        "removed": "#ed879680",
        "context": "#1e2030"
      },
      "highlight": {
        "added": "#a6da95",
        "removed": "#ed8796"
      },
      "lineNumber": {
        "text": "#494d64",
        "background": {
          "added": "#a6da9540",
          "removed": "#ed879640"
        }
      }
    },
    "syntax": {
      "comment": "#939ab7",
      "keyword": "#8aadf4",
      "function": "#8aadf4",
      "variable": "#ed8796",
      "string": "#a6da95",
      "number": "#f5a97f",
      "type": "#eed49f",
      "operator": "#91d7e3",
      "punctuation": "#cad3f5"
    },
    "markdown": {
      "text": "#cad3f5",
      "heading": "#8aadf4",
      "link": "#8aadf4",
      "linkText": "#91d7e3",
      "code": "#a6da95",
      "blockQuote": "#eed49f",
      "emphasis": "#eed49f",
      "strong": "#f5a97f",
      "horizontalRule": "#a5adcb",
      "listItem": "#8aadf4",
      "listEnumeration": "#91d7e3",
      "image": "#8aadf4",
      "imageText": "#91d7e3",
      "codeBlock": "#cad3f5"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base"
      }
    }
  },
  "dark": {
    "hue": {
      "red": {
        "100": "#f8cfd5",
        "200": "#f4b7c0",
        "300": "#f19fab",
        "400": "#ed8796",
        "500": "#c97380",
        "600": "#a65e69",
        "700": "#824a52",
        "800": "#5f363c",
        "900": "#3b2226"
      },
      "orange": {
        "100": "#fbddcc",
        "200": "#f9cbb2",
        "300": "#f7ba99",
        "400": "#f5a97f",
        "500": "#d0906c",
        "600": "#ac7659",
        "700": "#875d46",
        "800": "#624433",
        "900": "#3d2a20"
      },
      "yellow": {
        "100": "#f8eed9",
        "200": "#f5e5c5",
        "300": "#f1ddb2",
        "400": "#eed49f",
        "500": "#cab487",
        "600": "#a7946f",
        "700": "#837557",
        "800": "#5f5540",
        "900": "#3c3528"
      },
      "green": {
        "100": "#dbf0d5",
        "200": "#cae9bf",
        "300": "#b8e1aa",
        "400": "#a6da95",
        "500": "#8db97f",
        "600": "#749968",
        "700": "#5b7852",
        "800": "#42573c",
        "900": "#2a3625"
      },
      "cyan": {
        "100": "#d1eeea",
        "200": "#b9e6df",
        "300": "#a2ddd5",
        "400": "#8bd5ca",
        "500": "#76b5ac",
        "600": "#61958d",
        "700": "#4c756f",
        "800": "#385551",
        "900": "#233532"
      },
      "blue": {
        "100": "#d0defb",
        "200": "#b9cef8",
        "300": "#a1bdf6",
        "400": "#8aadf4",
        "500": "#7593cf",
        "600": "#6179ab",
        "700": "#4c5f86",
        "800": "#374562",
        "900": "#222b3d"
      },
      "purple": {
        "100": "#e8d9fb",
        "200": "#ddc6fa",
        "300": "#d1b3f8",
        "400": "#c6a0f6",
        "500": "#a888d1",
        "600": "#8b70ac",
        "700": "#6d5887",
        "800": "#4f4062",
        "900": "#32283e"
      },
      "gray": {
        "100": "#cad3f5",
        "200": "#b8c0e0",
        "300": "#a5adcb",
        "400": "#939ab7",
        "500": "#8087a2",
        "600": "#6e738d",
        "700": "#5b6078",
        "800": "#494d64",
        "900": "#363a4f"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    }
  }
}
