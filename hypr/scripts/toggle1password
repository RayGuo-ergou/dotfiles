#!/bin/bash

toggle_1password() {
    local current_workspace
    current_workspace=$(hyprctl activeworkspace -j | jq -r '.id')

    local onepassword_workspace
    onepassword_workspace=$(hyprctl -j clients | jq -r '.[] | select(.class == "1Password" or .class == "1password") | .workspace.id' | head -n1)

    if [[ -z $onepassword_workspace || $current_workspace == "$onepassword_workspace" ]]; then
        # For some reason the `1password --toggle not working when not focused`
        hyprctl dispatch 'hl.dsp.focus({ window = "class:^(1Password|1password)$" })'
        1password --toggle
    else
        hyprctl dispatch "hl.dsp.window.move({ workspace = '${current_workspace}', window = 'class:^(1Password|1password)$' })"
    fi
}

toggle_1password
